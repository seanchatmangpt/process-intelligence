/// Heuristics miner refusal reasons
#[derive(Debug, Clone)]
pub enum HeuristicsRefusal {
    /// Log contains no activity sequences
    EmptyLog,
    /// Log is not in admitted state
    LogNotAdmitted,
    /// Dependency measure computation failed
    ComputationFailed,
    /// Not yet implemented
    NotImplementedYet,
}

