# Generated PDFs (keep source documents, ignore rendered output)
# Note: source .pdf papers in sources/papers/ are NOT ignored — they are evidence
# This ignores only generated/rendered PDFs in output directories
output/*.pdf
rendered/*.pdf
generated/*.pdf

