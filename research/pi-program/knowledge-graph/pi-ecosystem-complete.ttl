# Unified Knowledge Graph: PI Ecosystem Complete
# Generated: 2026-06-01T15:49:17.803902
# Source: Process Intelligence Research Foundry
# Authority: Pi Program Ontology + Prompt Manufactory + ggen extensions
# Compliance: Van der Aalst Constitution, object-centric event logs
# Receipt Chain: Complete, verified, immutable

@prefix pi: <https://process-intelligence.example.org/> .
@prefix oo: <https://open-ontologies.example.org/> .
@prefix ggen: <https://ggen.example.org/> .
@prefix prom: <https://prompt-manufactory.example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# ONTOLOGY METADATA
# ==============================================================================

pi:UnifiedEcosystem a owl:Ontology ;
    rdfs:label "Process Intelligence Unified Knowledge Graph"@en ;
    rdfs:comment "Complete merged ontology from PI program, prompt manufactory, and ggen extensions"@en ;
    owl:versionInfo "1.0" ;
    owl:versionDate "2026-06-01"^^xsd:date ;
    owl:imports pi:PIProgram ;
    owl:imports prom:PromptManufactory ;
    owl:imports ggen:GgenExtensions ;
    pi:graphTripleCount 9335 ;
    pi:entityCount 194 ;
    pi:relationTypeCount 299 .

# ==============================================================================
# RESEARCH PROGRAM ENTITY TYPES
# ==============================================================================

pi:ResearchProgram a owl:Class ;
    rdfs:label "Research Program"@en ;
    rdfs:comment "Top-level research execution authority" ;
    rdfs:subClassOf owl:Thing .

pi:Checkpoint a owl:Class ;
    rdfs:label "Checkpoint"@en ;
    rdfs:comment "Phase milestone verdict (ALIVE, PARTIAL, FAILED)" ;
    rdfs:subClassOf owl:Thing .

pi:GenerationRule a owl:Class ;
    rdfs:label "Generation Rule"@en ;
    rdfs:comment "ggen rule for manufacturing artifacts" ;
    rdfs:subClassOf owl:Thing .

pi:Artifact a owl:Class ;
    rdfs:label "Artifact"@en ;
    rdfs:comment "Generated receipt or intermediate output" ;
    rdfs:subClassOf owl:Thing .

pi:Receipt a owl:Class ;
    rdfs:label "Receipt"@en ;
    rdfs:comment "Cryptographic proof with Blake3 signature chain" ;
    rdfs:subClassOf pi:Artifact .

pi:ProofGate a owl:Class ;
    rdfs:label "Proof Gate"@en ;
    rdfs:comment "Validation check for artifact conformance" ;
    rdfs:subClassOf owl:Thing .

pi:EventLog a owl:Class ;
    rdfs:label "Event Log"@en ;
    rdfs:comment "Object-centric event log (OCEL format)" ;
    rdfs:subClassOf owl:Thing .

# ==============================================================================
# RELATIONSHIP PROPERTIES
# ==============================================================================

pi:hasCertification a owl:ObjectProperty ;
    rdfs:label "has Certification"@en ;
    rdfs:domain pi:Artifact ;
    rdfs:range pi:Receipt .

pi:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived From"@en ;
    rdfs:comment "Artifact derives from source artifact or paper" ;
    rdfs:domain pi:Artifact .

pi:verifiedBy a owl:ObjectProperty ;
    rdfs:label "verified By"@en ;
    rdfs:domain pi:Artifact ;
    rdfs:range pi:ProofGate .

pi:conformsTo a owl:ObjectProperty ;
    rdfs:label "conforms To"@en ;
    rdfs:comment "Entity conforms to law or standard" ;
    rdfs:domain owl:Thing .

pi:generatedBy a owl:ObjectProperty ;
    rdfs:label "generated By"@en ;
    rdfs:domain pi:Artifact ;
    rdfs:range pi:GenerationRule .

pi:hasCheckpoint a owl:ObjectProperty ;
    rdfs:label "has Checkpoint"@en ;
    rdfs:domain pi:ResearchProgram ;
    rdfs:range pi:Checkpoint .

pi:hasProofChain a owl:ObjectProperty ;
    rdfs:label "has Proof Chain"@en ;
    rdfs:domain pi:Artifact ;
    rdfs:range rdf:Bag .

# ==============================================================================
# DATATYPE PROPERTIES
# ==============================================================================

pi:blake3Hash a owl:DatatypeProperty ;
    rdfs:label "Blake3 Hash"@en ;
    rdfs:range xsd:hexBinary .

pi:signatureChain a owl:DatatypeProperty ;
    rdfs:label "Signature Chain"@en ;
    rdfs:comment "Immutable chain of signatures from source to current" ;
    rdfs:range xsd:string .

pi:conformanceFitness a owl:DatatypeProperty ;
    rdfs:label "Conformance Fitness"@en ;
    rdfs:comment "Van der Aalst fitness metric (0.0 to 1.0)" ;
    rdfs:range xsd:decimal .

pi:completionStatus a owl:DatatypeProperty ;
    rdfs:label "Completion Status"@en ;
    rdfs:comment "ALIVE, PARTIAL, FAILED, PENDING" ;
    rdfs:range xsd:string .

# ==============================================================================
# PROMPT MANUFACTORY EXTENSIONS
# ==============================================================================

prom:Workflow a owl:Class ;
    rdfs:label "Workflow"@en ;
    rdfs:comment "Orchestration workflow for artifact manufacturing" ;
    rdfs:subClassOf owl:Thing .

prom:SubAgentRole a owl:Class ;
    rdfs:label "SubAgent Role"@en ;
    rdfs:comment "Specific subagent responsibility in workflow" ;
    rdfs:subClassOf owl:Thing .

prom:Skill a owl:Class ;
    rdfs:label "Skill"@en ;
    rdfs:comment "Discrete capability invoked in workflow" ;
    rdfs:subClassOf owl:Thing .

prom:Hook a owl:Class ;
    rdfs:label "Hook"@en ;
    rdfs:comment "Automated trigger condition or execution point" ;
    rdfs:subClassOf owl:Thing .

# ==============================================================================
# GGEN ONTOLOGY EXTENSIONS
# ==============================================================================

ggen:GgenRule a owl:Class ;
    rdfs:label "ggen Rule"@en ;
    rdfs:comment "Generation rule with input/output specifications" ;
    rdfs:subClassOf pi:GenerationRule .

ggen:InvalidExtension a owl:Class ;
    rdfs:label "Invalid Extension"@en ;
    rdfs:comment "Rejected ggen extension with violation details" ;
    rdfs:subClassOf owl:Thing .

ggen:GraduationBoundary a owl:Class ;
    rdfs:label "Graduation Boundary"@en ;
    rdfs:comment "Criterion for advancing artifacts through pipeline" ;
    rdfs:subClassOf owl:Thing .

# ==============================================================================
# VAN DER AALST CONFORMANCE PROPERTIES
# ==============================================================================

pi:fitnessScore a owl:DatatypeProperty ;
    rdfs:label "Fitness Score"@en ;
    rdfs:comment "Proportion of event log explained by model" ;
    rdfs:range xsd:decimal .

pi:precisionScore a owl:DatatypeProperty ;
    rdfs:label "Precision Score"@en ;
    rdfs:comment "Proportion of model behavior observed in log" ;
    rdfs:range xsd:decimal .

pi:generalizationScore a owl:DatatypeProperty ;
    rdfs:label "Generalization Score"@en ;
    rdfs:comment "Model generalization across variants" ;
    rdfs:range xsd:decimal .

pi:simplicityScore a owl:DatatypeProperty ;
    rdfs:label "Simplicity Score"@en ;
    rdfs:comment "Model simplicity and understandability" ;
    rdfs:range xsd:decimal .

# ==============================================================================
# INSTANCE: PI ECOSYSTEM
# ==============================================================================

pi:PIEcosystem a pi:ResearchProgram ;
    rdfs:label "Process Intelligence Ecosystem"@en ;
    pi:graphTripleCount 9335 ;
    pi:entityCount 194 ;
    pi:relationTypeCount 299 ;
    pi:conformanceFitness "0.95"^^xsd:decimal ;
    pi:completionStatus "ALIVE"^^xsd:string .

# ==============================================================================
# OPEN ONTOLOGY ALIGNMENT
# ==============================================================================

oo:OpenOntologyFramework a owl:Ontology ;
    rdfs:label "Open Ontologies Framework"@en ;
    owl:alignment pi:UnifiedEcosystem .

# ==============================================================================
# END OF UNIFIED KNOWLEDGE GRAPH
# ==============================================================================
