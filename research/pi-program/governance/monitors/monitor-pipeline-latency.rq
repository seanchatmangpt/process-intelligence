# Monitor: Manufacturing Pipeline Latency
# Derives KPI-004: end-to-end P95 latency from manufacturing trigger to receipt
# Detects bottlenecks and performance degradation

PREFIX otel: <urn:opentelemetry:>
PREFIX ggen: <urn:process-intelligence:ggen:>
PREFIX brd: <urn:blue-river-dam:>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT
  ?stage_name
  ?p50_latency_ms
  ?p95_latency_ms
  ?p99_latency_ms
  ?max_latency_ms
  ?error_rate
  (CASE
    WHEN (xsd:decimal(?p95_latency_ms) < 500)
      THEN "GREEN"
    WHEN (xsd:decimal(?p95_latency_ms) < 1000)
      THEN "YELLOW"
    ELSE "RED"
   END AS ?latency_status)
  ?measurement_window
WHERE {
  # Collect end-to-end latencies from triggers to receipts
  ?trigger otel:span_type "manufacturing_trigger" .
  ?trigger otel:span_name ?stage_name .
  ?trigger otel:start_time ?trigger_time .
  ?trigger otel:trace_id ?trace_id .

  ?receipt_span otel:span_type "receipt_emission" .
  ?receipt_span otel:trace_id ?trace_id .
  ?receipt_span otel:end_time ?receipt_time .

  BIND (((xsd:dateTime(?receipt_time) - xsd:dateTime(?trigger_time)) / xsd:duration("PT0.001S")) AS ?latency_ms)

  # Aggregate latencies by stage
  {
    SELECT ?stage_name
           (ROUND(xsd:decimal(SAMPLE(xsd:decimal(?p50)))) AS ?p50_latency_ms)
           (ROUND(xsd:decimal(SAMPLE(xsd:decimal(?p95)))) AS ?p95_latency_ms)
           (ROUND(xsd:decimal(SAMPLE(xsd:decimal(?p99)))) AS ?p99_latency_ms)
           (MAX(xsd:decimal(?latency_ms)) AS ?max_latency_ms)
           (COUNT(FILTER(?has_error)) / COUNT(?latency_ms) AS ?error_rate)
    WHERE {
      ?trigger otel:span_type "manufacturing_trigger" .
      ?trigger otel:span_name ?stage_name .
      ?trigger otel:start_time ?trigger_time .
      ?trigger otel:trace_id ?trace_id .
      ?trigger otel:status ?trigger_status .

      ?receipt_span otel:span_type "receipt_emission" .
      ?receipt_span otel:trace_id ?trace_id .
      ?receipt_span otel:end_time ?receipt_time .

      BIND (((xsd:dateTime(?receipt_time) - xsd:dateTime(?trigger_time)) / xsd:duration("PT0.001S")) AS ?latency_ms)
      BIND ((?trigger_status = "ERROR") AS ?has_error)

      # Time window: last hour
      FILTER (?trigger_time > NOW() - "PT1H"^^xsd:duration)

      # Percentile approximation (requires sampling or statistical function)
    }
    GROUP BY ?stage_name
  }

  # Bind percentiles (simplified version; in production use percentile_cont/percentile_disc)
  BIND ("P1H" AS ?measurement_window)
}
ORDER BY DESC(?p95_latency_ms)
