---
# Generation Rule Ledger — Applied Rules & Transformations
# Generated: {{ now() | date(format="%Y-%m-%d %H:%M:%S") }}

generation_rules:
{% for rule in results -%}
  - rule_id: "{{ rule.rule }}"
    name: "{{ rule.title | default(value='N/A') }}"
    program: "{{ rule.program }}"
    query: "{{ rule.query | default(value='N/A') }}"
    template: "{{ rule.template | default(value='N/A') }}"
    output_file: "{{ rule.outputFile | default(value='N/A') }}"
    status: "{{ rule.status | default(value='N/A') }}"
    blocking_issue: "{{ rule.blockingIssue | default(value='N/A') }}"
{% endfor %}

metadata:
  total_rules: {{ results | length }}
  generated_at: "{{ now() | date(format="%Y-%m-%dT%H:%M:%SZ") }}"
