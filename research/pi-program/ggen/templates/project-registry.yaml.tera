---
# Project Registry — GGen Unified Run
# Generated: {{ generated_at }}
# Run ID: {{ run.run_id }}

projects:
{% for project in projects %}
  - id: {{ project.id }}
    name: "{{ project.name }}"
    description: "{{ project.description }}"
    status: {{ project.status }}
    owner: "{{ project.owner }}"
    repository: "{{ project.repository }}"
    authority_level: {{ project.authority_level }}

    artifacts:
{% for artifact in project.artifacts %}
      - id: {{ artifact.id }}
        name: "{{ artifact.name }}"
        type: {{ artifact.type }}
        path: "{{ artifact.output_path }}"
        checksum: "{{ artifact.checksum }}"
        size_bytes: {{ artifact.size_bytes }}
        created_at: "{{ artifact.created_at }}"
{% endfor %}

    generation_rules_applied: {{ project.generation_rules_applied | length }}

    conformance:
      declared_model_type: {{ project.conformance.declared_model_type }}
      actual_behavior: {{ project.conformance.actual_behavior }}
      fitness: {{ project.conformance.fitness }}
      precision: {{ project.conformance.precision }}
      generalization: {{ project.conformance.generalization }}

    proof_gates:
{% for gate in project.proof_gates %}
      - name: "{{ gate.name }}"
        status: {{ gate.status }}
        verdict: {{ gate.verdict }}
        timestamp: "{{ gate.timestamp }}"
{% endfor %}

    metadata:
      indexed_at: "{{ project.metadata.indexed_at }}"
      last_modified: "{{ project.metadata.last_modified }}"
      total_lines_generated: {{ project.metadata.total_lines_generated }}

{% endfor %}

summary:
  total_projects: {{ projects | length }}
  projects_successful: {{ projects | select(attribute='status', value='success') | length }}
  projects_partial: {{ projects | select(attribute='status', value='partial') | length }}
  projects_failed: {{ projects | select(attribute='status', value='failed') | length }}
