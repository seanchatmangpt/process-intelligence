---
# Rendered Artifact Ledger — Generated Outputs
# Generated: {{ now() | date(format="%Y-%m-%d %H:%M:%S") }}

artifacts:
{% for rule in results -%}
  - rule_id: "{{ rule.rule }}"
    title: "{{ rule.title }}"
    output_file: "{{ rule.outputFile }}"
    output_mode: "{{ rule.outputMode | default(value='N/A') }}"
    target_format: "{{ rule.targetFormat | default(value='N/A') }}"
    audience: "{{ rule.audience | default(value='N/A') }}"
    evidence: "{{ rule.evidence | default(value='N/A') }}"
    status: "{{ rule.status | default(value='N/A') }}"
{% endfor %}

metadata:
  total_artifacts: {{ results | length }}
  generated_at: "{{ now() | date(format="%Y-%m-%dT%H:%M:%SZ") }}"
