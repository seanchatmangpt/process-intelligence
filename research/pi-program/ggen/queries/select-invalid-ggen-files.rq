PREFIX pi: <https://process.intelligence/ontology/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT ?file ?title ?classification ?purpose ?remediationRoute
WHERE {
    ?file a pi:GgenFile .
    ?file dcterms:title ?title .
    ?file pi:classification ?classification .
    OPTIONAL { ?file pi:purpose ?purpose }
    OPTIONAL { ?file pi:remediationRoute ?remediationRoute }
}
ORDER BY ?title
