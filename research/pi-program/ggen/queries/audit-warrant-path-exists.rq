# Audit Query: Warrant Path Exists
# ASSERT: Every ALIVE verdict has a complete provenance chain from checkpoint to source evidence

PREFIX ggen: <http://purl.org/ggen/core#>

ASK {
  ?checkpoint a ggen:Checkpoint .
  ?checkpoint ggen:verdict ggen:Alive .
  FILTER NOT EXISTS {
    ?checkpoint ggen:receipt ?receipt .
    ?receipt ggen:traces ?artifact .
    ?artifact ggen:sourceRule ?rule .
    ?rule ggen:evidenceSource ?evidence .
  }
}
