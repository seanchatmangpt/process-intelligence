# Selection Query: Remediation Candidates
# Returns artifacts and rules requiring remediation based on failed gates

PREFIX ggen: <http://purl.org/ggen/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?candidate ?candidateType ?failedGate ?remedyPath ?priority
WHERE {
  {
    ?artifact a ggen:RenderedArtifact .
    ?artifact ggen:status ggen:Invalid .
    ?gate a ggen:ProofGate .
    ?gate ggen:artifact ?artifact .
    ?gate ggen:status ggen:Failed .
    BIND(?artifact AS ?candidate)
    BIND("artifact" AS ?candidateType)
    BIND(?gate AS ?failedGate)
  }
  UNION
  {
    ?rule a ggen:GenerationRule .
    ?rule ggen:status ggen:Invalid .
    BIND(?rule AS ?candidate)
    BIND("rule" AS ?candidateType)
  }
  OPTIONAL { ?candidate ggen:remedyPath ?remedyPath }
  OPTIONAL { ?candidate ggen:priority ?priority }
}
ORDER BY ?priority DESC(?candidate)
