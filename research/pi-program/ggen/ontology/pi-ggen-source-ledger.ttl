# ============================================================================
# STATISTICS
# ============================================================================

<https://process.intelligence/unified-source-ledger/statistics>
  a prov:Entity ;
  dcterms:title "Source Ledger Statistics"@en ;
  dcterms:description "Aggregate statistics for all 92 source files"@en ;
  rdf:value "ggen.toml projects: 3, Total source files: 92, Valid ontologies: 22, Valid queries: 36, Valid templates: 34, Parse status VALID: 92 (100%), Referenced sources: 51 (55.4%), Unreferenced sources: 41 (44.6%)"@en ;
  prov:wasGeneratedBy "ggen unified run 2026-06-01"@en .
