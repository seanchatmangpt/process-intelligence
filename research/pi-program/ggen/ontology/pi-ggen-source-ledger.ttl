# pi-ggen-source-ledger.ttl
# Unified Program Graph — All TTL, RQ, Tera Source Inventory
# Authority: Process Intelligence Research Foundry
# Date: 2026-06-01
# Scope: Complete ledger of 92 valid source files across all ggen projects

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pi: <https://process.intelligence/ontology/> .
@prefix usl: <https://process.intelligence/unified-source-ledger/> .
@prefix proj: <https://process.intelligence/project/> .

# ============================================================================
# ONTOLOGY HEADER
# ============================================================================

<https://process.intelligence/unified-source-ledger/ontology>
  a owl:Ontology ;
  dcterms:title "Unified Program Graph — Source Ledger"@en ;
  dcterms:description "Complete inventory of all 92 valid TTL ontologies, SPARQL queries, and Tera templates consumed and produced by ggen manufacturing pipelines across all projects."@en ;
  dcterms:creator "Process Intelligence Research Foundry"@en ;
  dcterms:created "2026-06-01"^^xsd:date ;
  dcterms:modified "2026-06-01"^^xsd:date ;
  owl:imports <https://process.intelligence/ontology/> ;
  owl:imports <http://www.w3.org/ns/dcat#> ;
  owl:imports <http://www.w3.org/ns/prov#> ;
  skos:definition "Authoritative ledger of ggen source surfaces: 22 TTL ontologies, 36 SPARQL queries, 34 Tera templates. Tracks parse status, project ownership, dependencies, and manufacturing state."@en ;
  skos:note "All 92 sources parse successfully. 51 (55.4%) are referenced in generation rules; 41 (44.6%) are unreferenced (candidates for future integration or legacy artifacts)."@en .

# ============================================================================
# CLASSES
# ============================================================================

usl:OntologyGraph
  a owl:Class ;
  rdfs:label "Ontology Graph"@en ;
  rdfs:comment "A valid RDF/Turtle ontology file (.ttl) with parse-verified structure."@en ;
  skos:definition "A prov:Entity representing a single TTL file consumed by ggen queries or produced as intermediate representation."@en ;
  rdfs:subClassOf dcat:Distribution ;
  rdfs:subClassOf prov:Entity .

usl:QuerySurface
  a owl:Class ;
  rdfs:label "Query Surface"@en ;
  rdfs:comment "A SPARQL 1.1 query file (.rq) with verified syntax and ontology binding."@en ;
  skos:definition "A prov:Entity representing a SELECT/CONSTRUCT/ASK query that extracts facts from ontologies for template rendering."@en ;
  rdfs:subClassOf dcat:Distribution ;
  rdfs:subClassOf prov:Entity .

usl:TemplateSurface
  a owl:Class ;
  rdfs:label "Template Surface"@en ;
  rdfs:comment "A Tera template file (.tera) with verified Jinja2-compatible syntax."@en ;
  skos:definition "A prov:Entity representing a template that renders Tera artifacts from SPARQL query results."@en ;
  rdfs:subClassOf dcat:Distribution ;
  rdfs:subClassOf prov:Entity .

usl:SourceClassification
  a owl:Class ;
  rdfs:label "Source Classification"@en ;
  rdfs:comment "Type classification for source surfaces: Ontology, Query, or Template."@en ;
  owl:disjointUnionOf (
    usl:ONTOLOGY_CLASS
    usl:QUERY_CLASS
    usl:TEMPLATE_CLASS
  ) .

usl:ONTOLOGY_CLASS a owl:Class ; rdfs:label "Ontology" .
usl:QUERY_CLASS a owl:Class ; rdfs:label "Query" .
usl:TEMPLATE_CLASS a owl:Class ; rdfs:label "Template" .

usl:SourceRole
  a owl:Class ;
  rdfs:label "Source Role"@en ;
  rdfs:comment "Functional role of a source: Knowledge Base, Extraction, Document Generation, Code Generation."@en ;
  owl:disjointUnionOf (
    usl:KNOWLEDGE_BASE
    usl:EXTRACTION
    usl:DOCUMENT_GENERATION
    usl:CODE_GENERATION
  ) .

usl:KNOWLEDGE_BASE a owl:Class ; rdfs:label "Knowledge Base" .
usl:EXTRACTION a owl:Class ; rdfs:label "Extraction" .
usl:DOCUMENT_GENERATION a owl:Class ; rdfs:label "Document Generation" .
usl:CODE_GENERATION a owl:Class ; rdfs:label "Code Generation" .

usl:ParseStatus
  a owl:Class ;
  rdfs:label "Parse Status"@en ;
  rdfs:comment "Validation result for source file syntax."@en ;
  owl:disjointUnionOf (
    usl:VALID
    usl:SUSPICIOUS
    usl:ERROR
  ) .

usl:VALID a owl:Class ; rdfs:label "VALID" .
usl:SUSPICIOUS a owl:Class ; rdfs:label "SUSPICIOUS" .
usl:ERROR a owl:Class ; rdfs:label "ERROR" .

# ============================================================================
# PROPERTIES
# ============================================================================

usl:filePath
  a owl:DatatypeProperty ;
  rdfs:label "File Path"@en ;
  rdfs:comment "Absolute file system path to the source file."@en ;
  rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( usl:OntologyGraph usl:QuerySurface usl:TemplateSurface ) ] ;
  rdfs:range xsd:string .

usl:sourceClass
  a owl:ObjectProperty ;
  rdfs:label "Source Class"@en ;
  rdfs:comment "Classification of the source type."@en ;
  rdfs:range usl:SourceClassification ;
  skos:cardinality "exactly 1"@en .

usl:sourceRole
  a owl:ObjectProperty ;
  rdfs:label "Source Role"@en ;
  rdfs:comment "Functional role of the source in the manufacturing pipeline."@en ;
  rdfs:range usl:SourceRole ;
  skos:cardinality "exactly 1"@en .

usl:parseStatus
  a owl:ObjectProperty ;
  rdfs:label "Parse Status"@en ;
  rdfs:comment "Validation result for the source file."@en ;
  rdfs:range usl:ParseStatus ;
  skos:cardinality "exactly 1"@en .

usl:isReferencedInRule
  a owl:DatatypeProperty ;
  rdfs:label "Is Referenced In Rule"@en ;
  rdfs:comment "Whether the source is referenced by a ggen generation rule (true) or unreferenced (false)."@en ;
  rdfs:range xsd:boolean ;
  skos:cardinality "exactly 1"@en .

usl:fileSizeBytes
  a owl:DatatypeProperty ;
  rdfs:label "File Size (Bytes)"@en ;
  rdfs:comment "Size in bytes of the source file."@en ;
  rdfs:range xsd:integer .

usl:fileHash
  a owl:DatatypeProperty ;
  rdfs:label "File Hash"@en ;
  rdfs:comment "BLAKE3 digest of the file contents."@en ;
  rdfs:range xsd:string .

usl:ownedByProject
  a owl:ObjectProperty ;
  rdfs:label "Owned By Project"@en ;
  rdfs:comment "The project that owns and maintains this source file."@en ;
  rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( usl:OntologyGraph usl:QuerySurface usl:TemplateSurface ) ] ;
  rdfs:range pi:ReferencedProject ;
  skos:cardinality "exactly 1"@en .

usl:consumedByRule
  a owl:ObjectProperty ;
  rdfs:label "Consumed By Rule"@en ;
  rdfs:comment "Generation rule(s) that consume this source."@en ;
  rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( usl:OntologyGraph usl:QuerySurface usl:TemplateSurface ) ] ;
  rdfs:range pi:GenerationRule .

usl:producedByRule
  a owl:ObjectProperty ;
  rdfs:label "Produced By Rule"@en ;
  rdfs:comment "Generation rule(s) that produce this source (as intermediate artifacts)."@en ;
  rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( usl:OntologyGraph usl:QuerySurface usl:TemplateSurface ) ] ;
  rdfs:range pi:GenerationRule .

usl:dependsOn
  a owl:ObjectProperty ;
  rdfs:label "Depends On"@en ;
  rdfs:comment "Other source files this file imports or references."@en ;
  rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( usl:OntologyGraph usl:QuerySurface usl:TemplateSurface ) ] ;
  rdfs:range [ rdf:type owl:Class ; owl:unionOf ( usl:OntologyGraph usl:QuerySurface usl:TemplateSurface ) ] .

usl:containsNamespace
  a owl:DatatypeProperty ;
  rdfs:label "Contains Namespace"@en ;
  rdfs:comment "RDF namespace URIs defined or used in this source."@en ;
  rdfs:domain usl:OntologyGraph ;
  rdfs:range xsd:string ;
  skos:example "https://process.intelligence/ma/, http://www.w3.org/ns/prov#"@en .

usl:classCount
  a owl:DatatypeProperty ;
  rdfs:label "Class Count"@en ;
  rdfs:comment "Number of RDF classes defined in this ontology."@en ;
  rdfs:domain usl:OntologyGraph ;
  rdfs:range xsd:integer .

usl:propertyCount
  a owl:DatatypeProperty ;
  rdfs:label "Property Count"@en ;
  rdfs:comment "Number of RDF properties defined in this ontology."@en ;
  rdfs:domain usl:OntologyGraph ;
  rdfs:range xsd:integer .

usl:tripleCount
  a owl:DatatypeProperty ;
  rdfs:label "Triple Count"@en ;
  rdfs:comment "Number of RDF triples in this ontology."@en ;
  rdfs:domain usl:OntologyGraph ;
  rdfs:range xsd:integer .

# ============================================================================
# SHAPES
# ============================================================================

usl:OntologyGraphShape
  a sh:NodeShape ;
  sh:targetClass usl:OntologyGraph ;
  sh:closed false ;
  sh:property [
    sh:path usl:filePath ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "OntologyGraph must have exactly one file path."@en
  ] ;
  sh:property [
    sh:path usl:parseStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "OntologyGraph must have exactly one parse status."@en
  ] ;
  sh:property [
    sh:path usl:ownedByProject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "OntologyGraph must be owned by exactly one project."@en
  ] .

usl:QuerySurfaceShape
  a sh:NodeShape ;
  sh:targetClass usl:QuerySurface ;
  sh:closed false ;
  sh:property [
    sh:path usl:filePath ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "QuerySurface must have exactly one file path."@en
  ] ;
  sh:property [
    sh:path usl:parseStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "QuerySurface must have exactly one parse status."@en
  ] .

