# pi-ggen-generation-ledger.ttl
# Unified Program Graph — All Generation Rules and Their Dependencies
# Authority: Process Intelligence Research Foundry
# Date: 2026-06-01
# Scope: Complete ledger of 7 active generation rules and their query/template dependencies

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pi: <https://process.intelligence/ontology/> .
@prefix ugl: <https://process.intelligence/unified-generation-ledger/> .
@prefix proj: <https://process.intelligence/project/> .

# ============================================================================
# ONTOLOGY HEADER
# ============================================================================

<https://process.intelligence/unified-generation-ledger/ontology>
  a owl:Ontology ;
  dcterms:title "Unified Program Graph — Generation Ledger"@en ;
  dcterms:description "Complete ledger of all generation rules that orchestrate ggen manufacturing: active rules, their SPARQL queries, Tera templates, output files, and proof gates."@en ;
  dcterms:creator "Process Intelligence Research Foundry"@en ;
  dcterms:created "2026-06-01"^^xsd:date ;
  dcterms:modified "2026-06-01"^^xsd:date ;
  owl:imports <https://process.intelligence/ontology/> ;
  owl:imports <http://www.w3.org/ns/prov#> ;
  skos:definition "Registry of all generation rules (query + template pairs) that transform ontology facts into rendered artifacts. Tracks active vs. deactivated rules, rule dependencies, execution order, and proof gate requirements."@en ;
  skos:note "7 active generation rules across 3 ggen.toml projects. Rules produce artifacts (Rust code, NextJS TypeScript, YAML, Markdown) backed by conformance gates and receipt chains."@en .

# ============================================================================
# CLASSES
# ============================================================================

ugl:GenerationRule
  a owl:Class ;
  rdfs:label "Generation Rule"@en ;
  rdfs:comment "A coordinated pair of SPARQL query and Tera template that manufactures an artifact from ontology facts."@en ;
  skos:definition "A prov:Activity that executes a SPARQL query over loaded ontologies and renders a Tera template to produce a single artifact file."@en ;
  rdfs:subClassOf prov:Activity .

ugl:RuleStatus
  a owl:Class ;
  rdfs:label "Rule Status"@en ;
  rdfs:comment "Execution status of a generation rule."@en ;
  owl:disjointUnionOf (
    ugl:ACTIVE
    ugl:DEACTIVATED
    ugl:CONDITIONAL
  ) .

ugl:ACTIVE a owl:Class ; rdfs:label "ACTIVE" .
ugl:DEACTIVATED a owl:Class ; rdfs:label "DEACTIVATED" .
ugl:CONDITIONAL a owl:Class ; rdfs:label "CONDITIONAL" .

ugl:RuleMode
  a owl:Class ;
  rdfs:label "Rule Mode"@en ;
  rdfs:comment "Output mode for artifact rendering."@en ;
  owl:disjointUnionOf (
    ugl:OVERWRITE
    ugl:APPEND
    ugl:MERGE
  ) .

ugl:OVERWRITE a owl:Class ; rdfs:label "Overwrite" .
ugl:APPEND a owl:Class ; rdfs:label "Append" .
ugl:MERGE a owl:Class ; rdfs:label "Merge" .

ugl:ArtifactFormat
  a owl:Class ;
  rdfs:label "Artifact Format"@en ;
  rdfs:comment "Output format of the rendered artifact."@en ;
  owl:disjointUnionOf (
    ugl:RUST_CODE
    ugl:TYPESCRIPT_CODE
    ugl:YAML_CONFIG
    ugl:MARKDOWN_DOC
    ugl:JSON_DATA
  ) .

ugl:RUST_CODE a owl:Class ; rdfs:label "Rust Code" .
ugl:TYPESCRIPT_CODE a owl:Class ; rdfs:label "TypeScript Code" .
ugl:YAML_CONFIG a owl:Class ; rdfs:label "YAML Config" .
ugl:MARKDOWN_DOC a owl:Class ; rdfs:label "Markdown Doc" .
ugl:JSON_DATA a owl:Class ; rdfs:label "JSON Data" .

ugl:RenderedArtifact
  a owl:Class ;
  rdfs:label "Rendered Artifact"@en ;
  rdfs:comment "Output artifact produced by a generation rule."@en ;
  skos:definition "A prov:Entity representing the rendered file emitted by a generation rule execution."@en ;
  rdfs:subClassOf prov:Entity ;
  rdfs:subClassOf dcat:Distribution .

# ============================================================================
# PROPERTIES
# ============================================================================

ugl:ruleName
  a owl:DatatypeProperty ;
  rdfs:label "Rule Name"@en ;
  rdfs:comment "Human-readable name of the generation rule."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range xsd:string ;
  skos:example "blue-river-orchestrator, visualizer-dashboard-nextjs"@en .

ugl:ruleDescription
  a owl:DatatypeProperty ;
  rdfs:label "Rule Description"@en ;
  rdfs:comment "Human-readable description of what the rule manufactures."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range xsd:string .

ugl:ruleStatus
  a owl:ObjectProperty ;
  rdfs:label "Rule Status"@en ;
  rdfs:comment "Whether the rule is actively executed, deactivated, or conditional."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range ugl:RuleStatus ;
  skos:cardinality "exactly 1"@en .

ugl:outputFormat
  a owl:ObjectProperty ;
  rdfs:label "Output Format"@en ;
  rdfs:comment "The format of artifacts produced by this rule."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range ugl:ArtifactFormat ;
  skos:cardinality "exactly 1"@en .

ugl:outputMode
  a owl:ObjectProperty ;
  rdfs:label "Output Mode"@en ;
  rdfs:comment "How the artifact is written to disk."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range ugl:RuleMode ;
  skos:cardinality "exactly 1"@en .

ugl:outputFilePath
  a owl:DatatypeProperty ;
  rdfs:label "Output File Path"@en ;
  rdfs:comment "Absolute path to the rendered artifact file."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range xsd:string .

ugl:queryFile
  a owl:DatatypeProperty ;
  rdfs:label "Query File"@en ;
  rdfs:comment "Path to the SPARQL query (.rq) executed by this rule."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range xsd:string .

ugl:templateFile
  a owl:DatatypeProperty ;
  rdfs:label "Template File"@en ;
  rdfs:comment "Path to the Tera template (.tera) executed by this rule."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range xsd:string .

ugl:consumes
  a owl:ObjectProperty ;
  rdfs:label "Consumes"@en ;
  rdfs:comment "Ontology or query surface consumed by this rule."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range [ rdf:type owl:Class ; owl:unionOf ( usl:OntologyGraph usl:QuerySurface ) ] .

ugl:produces
  a owl:ObjectProperty ;
  rdfs:label "Produces"@en ;
  rdfs:comment "Artifact(s) produced by this rule."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range ugl:RenderedArtifact ;
  skos:cardinality "at least 1"@en .

ugl:ruleOrder
  a owl:DatatypeProperty ;
  rdfs:label "Rule Order"@en ;
  rdfs:comment "Execution order (1-based) in the manufacturing pipeline."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range xsd:integer .

ugl:ownerProject
  a owl:ObjectProperty ;
  rdfs:label "Owner Project"@en ;
  rdfs:comment "The project that defines and maintains this rule."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range pi:ReferencedProject ;
  skos:cardinality "exactly 1"@en .

ugl:requiresGate
  a owl:ObjectProperty ;
  rdfs:label "Requires Gate"@en ;
  rdfs:comment "Audit gate(s) that must pass before this rule can execute."@en ;
  rdfs:domain ugl:GenerationRule ;
  rdfs:range pi:AuditGate .

ugl:audience
  a owl:DatatypeProperty ;
  rdfs:label "Audience"@en ;
  rdfs:comment "Intended audience or use case for the artifact."@en ;
  rdfs:domain ugl:RenderedArtifact ;
  rdfs:range xsd:string ;
  skos:example "Process Intelligence Runtime, Board-level M&A Review, Engineering Team"@en .

ugl:compliance
  a owl:DatatypeProperty ;
  rdfs:label "Compliance"@en ;
  rdfs:comment "Compliance framework or standard the artifact adheres to."@en ;
  rdfs:domain ugl:RenderedArtifact ;
  rdfs:range xsd:string ;
  skos:example "MAPE-K autonomic loop, BPMN 2.0, SOC2 Type II"@en .

ugl:evidenceBacking
  a owl:DatatypeProperty ;
  rdfs:label "Evidence Backing"@en ;
  rdfs:comment "What research evidence or doctrine backs this artifact."@en ;
  rdfs:domain ugl:RenderedArtifact ;
  rdfs:range xsd:string ;
  skos:example "PROCESS_INTELLIGENCE_ALIVE_001 checkpoint"@en .

# ============================================================================
# SHAPES
# ============================================================================

ugl:GenerationRuleShape
  a sh:NodeShape ;
  sh:targetClass ugl:GenerationRule ;
  sh:closed false ;
  sh:property [
    sh:path ugl:ruleName ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "GenerationRule must have exactly one rule name."@en
  ] ;
  sh:property [
    sh:path ugl:queryFile ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "GenerationRule must reference exactly one query file."@en
  ] ;
  sh:property [
    sh:path ugl:templateFile ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "GenerationRule must reference exactly one template file."@en
  ] ;
  sh:property [
    sh:path ugl:ruleStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "GenerationRule must have exactly one status."@en
  ] ;
  sh:property [
    sh:path ugl:ownerProject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "GenerationRule must be owned by exactly one project."@en
  ] .

# ============================================================================
# INSTANCES (7 Active Rules)
# ============================================================================

<https://process.intelligence/unified-generation-ledger/rule-blue-river-orchestrator>
  a ugl:GenerationRule ;
  dcterms:title "Blue River Orchestrator Rule"@en ;
  dcterms:description "Autonomic MAPE-K governance engine with lifecycle state transitions"@en ;
  ugl:ruleName "blue-river-orchestrator"@en ;
  ugl:ruleDescription "Generates Rust code implementing the MAPE-K autonomic monitoring-analyze-plan-execute loop with lifecycle state machine and governance rule enforcement."@en ;
  ugl:ruleStatus ugl:ACTIVE ;
  ugl:outputFormat ugl:RUST_CODE ;
  ugl:outputMode ugl:OVERWRITE ;
  ugl:outputFilePath "../blue_river_dam/src/lib.rs"@en ;
  ugl:queryFile "queries/extract-lifecycle-governance.rq"@en ;
  ugl:templateFile "templates/blue-river.tera"@en ;
  ugl:ruleOrder "1"^^xsd:integer ;
  ugl:ownerProject proj:process-intelligence ;
  ugl:audience "Process Intelligence Runtime"@en ;
  ugl:compliance "MAPE-K autonomic loop"@en ;
  ugl:evidenceBacking "lifecycle state machine + governance rule enforcement"@en ;
  prov:wasAttributedTo "Sean Chatman"@en ;
  dcterms:created "2026-01-15"^^xsd:date .

