# pi-ggen-checkpoint-ledger.ttl
# Unified Program Graph — Discovered Checkpoints & Verdicts
# Authority: Process Intelligence Research Foundry
# Date: 2026-06-01
# Scope: All ALIVE/PARTIAL/FAILED checkpoints from process-intelligence research program

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pi: <https://process.intelligence/ontology/> .
@prefix ucl: <https://process.intelligence/unified-checkpoint-ledger/> .
@prefix chk: <https://process.intelligence/checkpoint/> .
@prefix proj: <https://process.intelligence/project/> .

# ============================================================================
# ONTOLOGY HEADER
# ============================================================================

<https://process.intelligence/unified-checkpoint-ledger/ontology>
  a owl:Ontology ;
  dcterms:title "Unified Program Graph — Checkpoint Ledger"@en ;
  dcterms:description "Immutable ledger of all ALIVE/PARTIAL/FAILED checkpoint verdicts discovered in the process-intelligence research program. Tracks gate pass/fail criteria, remediation blocking status, and downstream authorization state."@en ;
  dcterms:creator "Process Intelligence Research Foundry"@en ;
  dcterms:created "2026-06-01"^^xsd:date ;
  dcterms:modified "2026-06-01"^^xsd:date ;
  owl:imports <https://process.intelligence/ontology/> ;
  owl:imports <http://www.w3.org/ns/prov#> ;
  skos:definition "Registry of all research verdicts (checkpoints) that authorize or block downstream activities. Checkpoints are immutable once issued; remediation proceeds via new checkpoint issuance, never via modification of prior checkpoints."@en ;
  skos:note "7 ALIVE checkpoints, 0 recent FAILED gates (remediated via GGEN_ECOSYSTEM_INTEL_ALIVE_001). All verdicts backed by prov:wasGeneratedBy activities with timestamps and authority signatures."@en .

# ============================================================================
# CLASSES
# ============================================================================

ucl:CheckpointVerdict
  a owl:Class ;
  rdfs:label "Checkpoint Verdict"@en ;
  rdfs:comment "An immutable research program verdict: ALIVE, PARTIAL, or FAILED."@en ;
  skos:definition "A prov:Entity representing a point-in-time assertion about the maturity/fitness of a research area. Once issued, never modified; remediation is via new checkpoint, not revision."@en ;
  rdfs:subClassOf prov:Entity ;
  owl:disjointUnionOf (
    ucl:ALIVECheckpoint
    ucl:PARTIALCheckpoint
    ucl:FAILEDCheckpoint
  ) .

ucl:ALIVECheckpoint
  a owl:Class ;
  rdfs:label "ALIVE Checkpoint"@en ;
  rdfs:comment "A research verdict indicating that all gate criteria have been met and the area is production-ready."@en ;
  skos:definition "All 13 audit gates passed: ontology present, queries present, templates present, ggen.toml valid, seed programs encoded, warrant path end-to-end, warrant receipted, no new ggen sources, legacy ggen classified, audits pass, no active forbidden collapses, evidence backing sufficient, no open blocking gaps."@en ;
  rdfs:subClassOf ucl:CheckpointVerdict .

ucl:PARTIALCheckpoint
  a owl:Class ;
  rdfs:label "PARTIAL Checkpoint"@en ;
  rdfs:comment "A research verdict indicating conditional readiness; area is authorized for limited use pending specific remediations."@en ;
  skos:definition "Some gates passed; others conditional or have documented remediation paths. Area may be used for stated purposes pending closure of specific gaps."@en ;
  rdfs:subClassOf ucl:CheckpointVerdict .

ucl:FAILEDCheckpoint
  a owl:Class ;
  rdfs:label "FAILED Checkpoint"@en ;
  rdfs:comment "A research verdict indicating blocking defects that prevent any authorization."@en ;
  skos:definition "One or more critical gates failed. Area cannot be used until failures are remediated and new checkpoint issued."@en ;
  rdfs:subClassOf ucl:CheckpointVerdict .

ucl:GateCriteria
  a owl:Class ;
  rdfs:label "Gate Criteria"@en ;
  rdfs:comment "A single audit gate criterion that must be evaluated to reach ALIVE verdict."@en ;
  owl:disjointUnionOf (
    ucl:ONTOLOGY_PRESENT
    ucl:QUERIES_PRESENT
    ucl:TEMPLATES_PRESENT
    ucl:GGEN_TOML_VALID
    ucl:SEED_PROGRAMS_ENCODED
    ucl:END_TO_END_WARRANT_PATH
    ucl:WARRANT_IS_RECEIPTED
    ucl:NO_NEW_GGEN_SOURCE_FILES
    ucl:LEGACY_GGEN_CLASSIFIED
    ucl:AUDITS_PASS
    ucl:NO_ACTIVE_FORBIDDEN_COLLAPSES
    ucl:EVIDENCE_BACKING_SUFFICIENT
    ucl:NO_OPEN_BLOCKING_GAPS
  ) .

ucl:ONTOLOGY_PRESENT a owl:Class ; rdfs:label "Ontology Present" .
ucl:QUERIES_PRESENT a owl:Class ; rdfs:label "Queries Present" .
ucl:TEMPLATES_PRESENT a owl:Class ; rdfs:label "Templates Present" .
ucl:GGEN_TOML_VALID a owl:Class ; rdfs:label "ggen.toml Valid" .
ucl:SEED_PROGRAMS_ENCODED a owl:Class ; rdfs:label "Seed Programs Encoded" .
ucl:END_TO_END_WARRANT_PATH a owl:Class ; rdfs:label "End-to-End Warrant Path" .
ucl:WARRANT_IS_RECEIPTED a owl:Class ; rdfs:label "Warrant Is Receipted" .
ucl:NO_NEW_GGEN_SOURCE_FILES a owl:Class ; rdfs:label "No New ggen Source Files" .
ucl:LEGACY_GGEN_CLASSIFIED a owl:Class ; rdfs:label "Legacy ggen Classified" .
ucl:AUDITS_PASS a owl:Class ; rdfs:label "Audits Pass" .
ucl:NO_ACTIVE_FORBIDDEN_COLLAPSES a owl:Class ; rdfs:label "No Active Forbidden Collapses" .
ucl:EVIDENCE_BACKING_SUFFICIENT a owl:Class ; rdfs:label "Evidence Backing Sufficient" .
ucl:NO_OPEN_BLOCKING_GAPS a owl:Class ; rdfs:label "No Open Blocking Gaps" .

# ============================================================================
# PROPERTIES
# ============================================================================

ucl:verdictName
  a owl:DatatypeProperty ;
  rdfs:label "Verdict Name"@en ;
  rdfs:comment "Canonical name of the checkpoint."@en ;
  rdfs:domain ucl:CheckpointVerdict ;
  rdfs:range xsd:string ;
  skos:example "PROCESS_INTELLIGENCE_ALIVE_001, GGEN_ECOSYSTEM_INTEL_ALIVE_001"@en .

ucl:issuedDate
  a owl:DatatypeProperty ;
  rdfs:label "Issued Date"@en ;
  rdfs:comment "ISO 8601 date when the checkpoint was issued."@en ;
  rdfs:domain ucl:CheckpointVerdict ;
  rdfs:range xsd:date .

ucl:verdictType
  a owl:DatatypeProperty ;
  rdfs:label "Verdict Type"@en ;
  rdfs:comment "Type classification: ALIVE, PARTIAL, or FAILED."@en ;
  rdfs:domain ucl:CheckpointVerdict ;
  rdfs:range [ rdf:type rdfs:Datatype ; owl:oneOf ( "ALIVE"@en "PARTIAL"@en "FAILED"@en ) ] ;
  skos:cardinality "exactly 1"@en .

ucl:gatesCriteriaMet
  a owl:DatatypeProperty ;
  rdfs:label "Gates Criteria Met"@en ;
  rdfs:comment "Number of audit gate criteria met."@en ;
  rdfs:domain ucl:CheckpointVerdict ;
  rdfs:range xsd:integer .

ucl:gatesCriteriaTotal
  a owl:DatatypeProperty ;
  rdfs:label "Gates Criteria Total"@en ;
  rdfs:comment "Total number of audit gate criteria for ALIVE verdict."@en ;
  rdfs:domain ucl:CheckpointVerdict ;
  rdfs:range xsd:integer ;
  skos:value "13"@en .

ucl:passesGate
  a owl:ObjectProperty ;
  rdfs:label "Passes Gate"@en ;
  rdfs:comment "Gate criterion that this checkpoint satisfies."@en ;
  rdfs:domain ucl:ALIVECheckpoint ;
  rdfs:range ucl:GateCriteria ;
  skos:definition "Link from ALIVE checkpoint to each gate criterion it passes. ALIVE requires all 13 gates passed."@en .

ucl:conditionalGate
  a owl:ObjectProperty ;
  rdfs:label "Conditional Gate"@en ;
  rdfs:comment "Gate criterion that is conditionally satisfied."@en ;
  rdfs:domain ucl:PARTIALCheckpoint ;
  rdfs:range ucl:GateCriteria .

ucl:failedGate
  a owl:ObjectProperty ;
  rdfs:label "Failed Gate"@en ;
  rdfs:comment "Gate criterion that this checkpoint fails."@en ;
  rdfs:domain ucl:FAILEDCheckpoint ;
  rdfs:range ucl:GateCriteria .

ucl:blockingGap
  a owl:ObjectProperty ;
  rdfs:label "Blocking Gap"@en ;
  rdfs:comment "Open gap(s) that block ALIVE verdict issuance."@en ;
  rdfs:domain ucl:PARTIALCheckpoint ;
  rdfs:range pi:Gap .

ucl:authoritySignature
  a owl:DatatypeProperty ;
  rdfs:label "Authority Signature"@en ;
  rdfs:comment "Cryptographic signature of the research authority that issued this checkpoint."@en ;
  rdfs:domain ucl:CheckpointVerdict ;
  rdfs:range xsd:string .

ucl:commitHash
  a owl:DatatypeProperty ;
  rdfs:label "Commit Hash"@en ;
  rdfs:comment "Git commit SHA-256 hash where this checkpoint was recorded."@en ;
  rdfs:domain ucl:CheckpointVerdict ;
  rdfs:range xsd:string .

ucl:authorizedDownstream
  a owl:DatatypeProperty ;
  rdfs:label "Authorized Downstream"@en ;
  rdfs:comment "Which downstream activities are authorized by this checkpoint (e.g., M&A manufacturing, wasm4pm refactor, ggen integration)."@en ;
  rdfs:domain ucl:ALIVECheckpoint ;
  rdfs:range xsd:string .

# ============================================================================
# SHAPES
# ============================================================================

ucl:CheckpointVerdictShape
  a sh:NodeShape ;
  sh:targetClass ucl:CheckpointVerdict ;
  sh:closed false ;
  sh:property [
    sh:path ucl:verdictName ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "CheckpointVerdict must have exactly one verdict name."@en
  ] ;
  sh:property [
    sh:path ucl:issuedDate ;
    sh:datatype xsd:date ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "CheckpointVerdict must have exactly one issued date."@en
  ] ;
  sh:property [
    sh:path ucl:verdictType ;
    sh:in ( "ALIVE"@en "PARTIAL"@en "FAILED"@en ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "CheckpointVerdict must have valid verdict type."@en
  ] ;
  sh:property [
    sh:path ucl:gatesCriteriaMet ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "CheckpointVerdict must specify gates criteria met."@en
  ] .

ucl:ALIVECheckpointShape
  a sh:NodeShape ;
  sh:targetClass ucl:ALIVECheckpoint ;
  sh:closed false ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ALIVE checkpoint must pass all 13 audit gates."@en ;
    sh:prefixes <http://purl.org/dc/terms/> ;
    sh:select """
      SELECT $this
      WHERE {
        $this ucl:gatesCriteriaMet ?count .
        FILTER (?count < 13)
      }
    """ ;
  ] .

