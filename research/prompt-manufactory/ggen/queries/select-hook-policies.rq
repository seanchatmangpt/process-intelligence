PREFIX pm:   <https://pi-research.dev/ontology/prompt-manufactory#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Select hook policies
# Used by hook-policy.md.tera to render hook policy documentation

SELECT ?hookId ?hookLabel ?hookTrigger ?hookAction
WHERE {
  ?hook a pm:HookPolicy ;
    rdfs:label ?hookLabel ;
    pm:hookTrigger ?hookTrigger ;
    pm:hookAction ?hookAction .
  
  OPTIONAL { ?hook pm:hookId ?hookId . }
}
ORDER BY ?hookLabel
