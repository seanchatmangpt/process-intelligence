@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix pm:   <https://pi-research.dev/ontology/prompt-manufactory#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ============================================================================
# GGEN PROMPT MANUFACTORY ONTOLOGY
# ============================================================================
# Core classes for research program manufacturing.
# All relations and properties defined here.
# Grounded in public vocabularies: PROV-O, DCTERMS, DCAT, SKOS, SHACL.
# No private vocabulary foundation.
# ============================================================================

# --- Classes ---

pm:ResearchProgram a rdfs:Class ;
  rdfs:comment "Top-level research program (PI, ZOEapp, wasm4pm-compat, etc.)" ;
  rdfs:subClassOf prov:Entity .

pm:Workflow a rdfs:Class ;
  rdfs:comment "Dynamic workflow with phases and subagents" ;
  rdfs:subClassOf prov:Entity .

pm:Phase a rdfs:Class ;
  rdfs:comment "One phase within a workflow" ;
  rdfs:subClassOf prov:Entity .

pm:SubagentRole a rdfs:Class ;
  rdfs:comment "Bounded inspection station with mission, owned/forbidden surfaces, output contract" ;
  rdfs:subClassOf prov:Entity .

pm:Skill a rdfs:Class ;
  rdfs:comment "Reusable standard-work capability (e.g., census, classify, audit)" ;
  rdfs:subClassOf prov:Entity .

pm:HookPolicy a rdfs:Class ;
  rdfs:comment "Andon gate: deterministic lifecycle enforcement" ;
  rdfs:subClassOf prov:Entity .

pm:Checkpoint a rdfs:Class ;
  rdfs:comment "ALIVE/PARTIAL verdict record" ;
  rdfs:subClassOf prov:Entity .

pm:RenderedPrompt a rdfs:Class ;
  rdfs:comment "Manufactured research warrant (typed by PromptClass)" ;
  rdfs:subClassOf prov:Entity .

pm:AuditGate a rdfs:Class ;
  rdfs:comment "Pass/fail condition for workflow" ;
  rdfs:subClassOf prov:Entity .

pm:RefusalCondition a rdfs:Class ;
  rdfs:comment "Named reason workflow execution must stop" ;
  rdfs:subClassOf prov:Entity .

pm:OwnedSurface a rdfs:Class ;
  rdfs:comment "File/directory surface a subagent inspects" ;
  rdfs:subClassOf prov:Entity .

pm:ForbiddenSurface a rdfs:Class ;
  rdfs:comment "Surface a subagent must not touch" ;
  rdfs:subClassOf prov:Entity .

pm:Receipt a rdfs:Class ;
  rdfs:comment "Proof-of-execution artifact with derivation and hash" ;
  rdfs:subClassOf prov:Entity .

pm:PromptClass a rdfs:Class ;
  rdfs:comment "Type of research warrant: INTEL | RECONCILE | REMEDIATE | SYNC | AUDIT | CHECKPOINT | SPR | LIVESTREAM" ;
  rdfs:subClassOf rdf:Property .

pm:InvalidGgenFile a rdfs:Class ;
  rdfs:comment "Classification record for legacy .ggen files found in referenced projects" ;
  rdfs:subClassOf prov:Entity .

# --- Relations (Object Properties) ---

pm:hasProject a rdf:Property ;
  rdfs:domain pm:ResearchProgram ;
  rdfs:range prov:Entity ;
  rdfs:comment "ResearchProgram references project" .

pm:hasWorkflow a rdf:Property ;
  rdfs:domain pm:ResearchProgram ;
  rdfs:range pm:Workflow ;
  rdfs:comment "ResearchProgram contains workflow" .

pm:hasPhase a rdf:Property ;
  rdfs:domain pm:Workflow ;
  rdfs:range pm:Phase ;
  rdfs:comment "Workflow contains phase" .

pm:hasSubagentRole a rdf:Property ;
  rdfs:domain pm:Phase ;
  rdfs:range pm:SubagentRole ;
  rdfs:comment "Phase requires subagent role" .

pm:ownsSurface a rdf:Property ;
  rdfs:domain pm:SubagentRole ;
  rdfs:range pm:OwnedSurface ;
  rdfs:comment "Subagent inspects owned surface" .

pm:forbidsSurface a rdf:Property ;
  rdfs:domain pm:SubagentRole ;
  rdfs:range pm:ForbiddenSurface ;
  rdfs:comment "Subagent must not touch forbidden surface" .

pm:hasAuditGate a rdf:Property ;
  rdfs:domain pm:Workflow ;
  rdfs:range pm:AuditGate ;
  rdfs:comment "Workflow enforces audit gate" .

pm:emitsRefusal a rdf:Property ;
  rdfs:domain pm:AuditGate ;
  rdfs:range pm:RefusalCondition ;
  rdfs:comment "Gate may fail with refusal" .

pm:emitsCheckpoint a rdf:Property ;
  rdfs:domain pm:Workflow ;
  rdfs:range pm:Checkpoint ;
  rdfs:comment "Workflow emits checkpoint verdict" .

pm:derivedFrom a rdf:Property ;
  rdfs:domain pm:RenderedPrompt ;
  rdfs:range prov:Entity ;
  rdfs:comment "Prompt derived from graph source (not hand-written)" .

pm:governedBy a rdf:Property ;
  rdfs:domain pm:RenderedPrompt ;
  rdfs:range pm:AuditGate ;
  rdfs:comment "Prompt must satisfy gate" .

pm:proves a rdf:Property ;
  rdfs:domain pm:Receipt ;
  rdfs:range pm:RenderedPrompt ;
  rdfs:comment "Receipt proves prompt was manufactured from law" .

pm:hasPromptClass a rdf:Property ;
  rdfs:domain pm:ResearchProgram ;
  rdfs:range pm:PromptClass ;
  rdfs:comment "Program emits this class of warrant" .

pm:hasOutputContract a rdf:Property ;
  rdfs:domain pm:SubagentRole ;
  rdfs:range xsd:string ;
  rdfs:comment "Subagent must produce output matching this description" .

pm:hasRefusalGate a rdf:Property ;
  rdfs:domain pm:SubagentRole ;
  rdfs:range pm:RefusalCondition ;
  rdfs:comment "Subagent may refuse under this condition" .

# --- Data Properties (Literal) ---

pm:programId a rdf:Property ;
  rdfs:domain pm:ResearchProgram ;
  rdfs:range xsd:string ;
  rdfs:comment "Unique identifier (e.g., PI_RESEARCH_PROGRAM_INTEL_001)" .

pm:mission a rdf:Property ;
  rdfs:domain prov:Entity ;
  rdfs:range xsd:string ;
  rdfs:comment "Human-readable description of purpose" .

pm:filePath a rdf:Property ;
  rdfs:domain pm:InvalidGgenFile ;
  rdfs:range xsd:string ;
  rdfs:comment "Absolute file path of .ggen artifact" .

pm:ownerProject a rdf:Property ;
  rdfs:domain pm:InvalidGgenFile ;
  rdfs:range xsd:string ;
  rdfs:comment "Project that owns this .ggen file" .

pm:classification a rdf:Property ;
  rdfs:domain pm:InvalidGgenFile ;
  rdfs:range xsd:string ;
  rdfs:comment "Classification: LEGACY_INVALID_SOURCE | RENDERED_ARTIFACT_WITH_WRONG_EXTENSION | MIGRATION_REQUIRED | OUT_OF_SCOPE_EXTERNAL_ARTIFACT | BLOCKING_SOURCE_SURFACE" .

pm:blockingStatus a rdf:Property ;
  rdfs:domain pm:InvalidGgenFile ;
  rdfs:range xsd:boolean ;
  rdfs:comment "true = blocks Prompt Manufactory; false = non-blocking migration" .

pm:remediationRoute a rdf:Property ;
  rdfs:domain pm:InvalidGgenFile ;
  rdfs:range xsd:string ;
  rdfs:comment "Remediation action: move, delete, rename, external, out-of-scope, etc." .

# --- Constraints (SHACL) ---

# Every ResearchProgram must have an ID
[] a sh:NodeShape ;
  sh:targetClass pm:ResearchProgram ;
  sh:property [
    sh:path pm:programId ;
    sh:minCount 1 ;
    sh:datatype xsd:string
  ] .

# Every SubagentRole must have a mission
[] a sh:NodeShape ;
  sh:targetClass pm:SubagentRole ;
  sh:property [
    sh:path pm:mission ;
    sh:minCount 1 ;
    sh:datatype xsd:string
  ] .

# Every RenderedPrompt must have derivedFrom source
[] a sh:NodeShape ;
  sh:targetClass pm:RenderedPrompt ;
  sh:property [
    sh:path pm:derivedFrom ;
    sh:minCount 1 ;
    sh:message "RenderedPrompt must have derivedFrom source (not hand-written)"
  ] .

# Every Checkpoint must have status (implied by ALIVE/PARTIAL verdict)
[] a sh:NodeShape ;
  sh:targetClass pm:Checkpoint ;
  sh:property [
    sh:path dct:issued ;
    sh:minCount 1 ;
    sh:datatype xsd:dateTime
  ] .
@prefix pm:   <https://pi-research.dev/ontology/prompt-manufactory#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ============================================================================
# CHECKPOINT LAW — ALIVE/PARTIAL Verdict Rules
# ============================================================================
# Defines when ALIVE can be emitted and when PARTIAL is required.
# ALIVE requires all critical gates to pass.
# PARTIAL is the honest verdict when any critical gate fails.
# ============================================================================

pm:CHECKPOINT_ALIVE a pm:Checkpoint ;
  rdfs:label "ALIVE Verdict" ;
  pm:mission "Emit when all critical gates pass and at least one end-to-end warrant path is proven" ;
  dct:description "ALIVE certifies the research program is fully operational and can render research warrants from law" ;
  rdfs:comment "ALIVE requires: all ontologies present, all queries/templates valid, end-to-end warrant proof successful, no new .ggen source files, all legacy .ggen classified, all audit gates pass" .

pm:CHECKPOINT_PARTIAL a pm:Checkpoint ;
  rdfs:label "PARTIAL Verdict" ;
  pm:mission "Emit when any critical gate fails or prerequisites are incomplete" ;
  dct:description "PARTIAL certifies the program structure is sound but not yet fully operational" ;
  rdfs:comment "PARTIAL is correct when: end-to-end warrant path not yet proven, legacy .ggen files not yet classified, PI_RESEARCH_PROGRAM_INTEL_001 topology incomplete, or audit gates fail" .

# --- ALIVE Gate Definitions ---

pm:GATE_ontology_present a pm:AuditGate ;
  rdfs:label "Ontology Files Present" ;
  pm:mission "All 8 .ttl ontology files exist and parse without error" ;
  pm:emitsRefusal pm:REFUSAL_MISSING_ONTOLOGY .

pm:GATE_queries_present a pm:AuditGate ;
  rdfs:label "Query Files Present" ;
  pm:mission "All 14 .rq SPARQL query files exist and have valid syntax" ;
  pm:emitsRefusal pm:REFUSAL_MISSING_QUERIES .

pm:GATE_templates_present a pm:AuditGate ;
  rdfs:label "Template Files Present" ;
  pm:mission "All 8 .tera Tera template files exist and have valid syntax" ;
  pm:emitsRefusal pm:REFUSAL_MISSING_TEMPLATES .

pm:GATE_ggen_toml_valid a pm:AuditGate ;
  rdfs:label "ggen.toml Valid" ;
  pm:mission "ggen.toml wires all 8 generation rules correctly" ;
  pm:emitsRefusal pm:REFUSAL_INVALID_GGEN_TOML .

pm:GATE_seed_programs_encoded a pm:AuditGate ;
  rdfs:label "Seed Programs Encoded" ;
  pm:mission "All 7 known programs exist as graph instances with required properties" ;
  pm:emitsRefusal pm:REFUSAL_INCOMPLETE_SEED_DATA .

pm:GATE_end_to_end_warrant_path a pm:AuditGate ;
  rdfs:label "End-to-End Warrant Path" ;
  pm:mission "At least one complete workflow prompt successfully renders from graph data (CRITICAL)" ;
  pm:emitsRefusal pm:REFUSAL_NO_WARRANT_PROOF .

pm:GATE_warrant_is_receipted a pm:AuditGate ;
  rdfs:label "Warrant is Receipted" ;
  pm:mission "Rendered prompt has entry in prompt-receipt-ledger with derivedFrom source" ;
  pm:emitsRefusal pm:REFUSAL_MISSING_RECEIPT .

pm:GATE_no_new_ggen_source_files a pm:AuditGate ;
  rdfs:label "No New .ggen Source Files" ;
  pm:mission "Zero .ggen files in prompt-manufactory/ggen/ source directory" ;
  pm:emitsRefusal pm:REFUSAL_INVALID_GGEN_SOURCE .

pm:GATE_legacy_ggen_classified a pm:AuditGate ;
  rdfs:label "Legacy .ggen Files Classified" ;
  pm:mission "All 22 existing .ggen files have classification ledger entry with owner/blocker/remediation" ;
  pm:emitsRefusal pm:REFUSAL_UNCLASSIFIED_LEGACY_GGEN .

pm:GATE_audits_pass a pm:AuditGate ;
  rdfs:label "All Audits Pass" ;
  pm:mission "All audit gates execute and return PASS: no-hand-written, no-forced-ALIVE, checkpoint-has-partial, no-file-count-alive" ;
  pm:emitsRefusal pm:REFUSAL_AUDIT_FAILED .

# --- Refusal Conditions for Checkpoints ---

pm:REFUSAL_MISSING_ONTOLOGY a pm:RefusalCondition ;
  rdfs:label "Missing Ontology" ;
  rdfs:comment "One or more required .ttl ontology files not found" .

pm:REFUSAL_MISSING_QUERIES a pm:RefusalCondition ;
  rdfs:label "Missing Queries" ;
  rdfs:comment "One or more required .rq SPARQL query files not found" .

pm:REFUSAL_MISSING_TEMPLATES a pm:RefusalCondition ;
  rdfs:label "Missing Templates" ;
  rdfs:comment "One or more required .tera Tera template files not found" .

pm:REFUSAL_INVALID_GGEN_TOML a pm:RefusalCondition ;
  rdfs:label "Invalid ggen.toml" ;
  rdfs:comment "ggen.toml missing or does not wire all 8 generation rules" .

pm:REFUSAL_INCOMPLETE_SEED_DATA a pm:RefusalCondition ;
  rdfs:label "Incomplete Seed Data" ;
  rdfs:comment "One or more of 7 seed programs missing from research-program-law.ttl" .

pm:REFUSAL_NO_WARRANT_PROOF a pm:RefusalCondition ;
  rdfs:label "No Warrant Proof" ;
  rdfs:comment "End-to-end warrant path (read instance → SPARQL → Tera → emit → audit) not yet executed successfully" .

pm:REFUSAL_MISSING_RECEIPT a pm:RefusalCondition ;
  rdfs:label "Missing Receipt" ;
  rdfs:comment "Rendered warrant has no entry in prompt-receipt-ledger or lacks derivedFrom triple" .

pm:REFUSAL_UNCLASSIFIED_LEGACY_GGEN a pm:RefusalCondition ;
  rdfs:label "Unclassified Legacy .ggen Files" ;
  rdfs:comment "One or more existing .ggen files lacks classification, owner, blocker status, or remediation route" .

pm:REFUSAL_AUDIT_FAILED a pm:RefusalCondition ;
  rdfs:label "Audit Failed" ;
  rdfs:comment "One or more required audit gates returned FAIL" .
@prefix pm:   <https://pi-research.dev/ontology/prompt-manufactory#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# ============================================================================
# FORBIDDEN COLLAPSE LAW
# ============================================================================
# Defines absolute boundaries that must not be crossed.
# Three categories: .ggen source files, DTO/JSON flattening, forced ALIVE.
# Also defines the classification system for legacy .ggen files.
# ============================================================================

# --- .ggen Source File Ban ---

pm:FORBIDDEN_ggen_source_files a rdfs:Class ;
  rdfs:label "Forbidden: .ggen Source Files" ;
  rdfs:comment "No .ggen extension files allowed in source directories (ggen/ontology, ggen/queries, ggen/templates, ggen.toml)" ;
  rdfs:comment "Valid source surfaces ONLY: .ttl, .rq, .tera, ggen.toml, .md (documentation)" ;
  rdfs:comment "Audit rule: find . -name '*.ggen' → must return zero results in prompt-manufactory/ggen/" .

# --- DTO/JSON Flattening Ban ---

pm:FORBIDDEN_dto_flattening a rdfs:Class ;
  rdfs:label "Forbidden: DTO/JSON Flattening" ;
  rdfs:comment "No collapse of structured Evidence<T, State, W> into casual JSON/string carriers without boundary classification" ;
  rdfs:comment "Examples: EvidenceDto, payload_json, state_tag as unbounded string" ;
  rdfs:comment "Refusal: REFUSAL_DTO_COLLAPSE" .

# --- Forced ALIVE Ban ---

pm:FORBIDDEN_forced_alive a rdfs:Class ;
  rdfs:label "Forbidden: Forced ALIVE" ;
  rdfs:comment "No ALIVE verdict claimed when critical audit gates have failed or prerequisite proofs are incomplete" ;
  rdfs:comment "PARTIAL is the honest verdict when: end-to-end warrant path unproven, legacy .ggen unclassified, or gates fail" ;
  rdfs:comment "Audit rule: FAIL if ALIVE claimed with unresolved blockers" .

# --- Legacy .ggen File Classification System ---

pm:InvalidGgenFile_Classification a rdfs:Class ;
  rdfs:label "Invalid .ggen File Classification" ;
  rdfs:subClassOf pm:InvalidGgenFile ;
  rdfs:comment "Classification system for the 22 legacy .ggen files found across the research tree" .

# Classification values (enumeration)

pm:LEGACY_INVALID_SOURCE a pm:InvalidGgenFile_Classification ;
  rdfs:label "LEGACY_INVALID_SOURCE" ;
  rdfs:comment "File was generated by previous workflow as source file with wrong extension; must be reclassified or deleted" .

pm:RENDERED_ARTIFACT_WITH_WRONG_EXTENSION a pm:InvalidGgenFile_Classification ;
  rdfs:label "RENDERED_ARTIFACT_WITH_WRONG_EXTENSION" ;
  rdfs:comment "File is a valid rendered artifact but has .ggen extension instead of intended output extension" ;
  rdfs:comment "Fix: rename to correct extension (e.g., audit-*.sh.ggen → audit-*.sh)" .

pm:MIGRATION_REQUIRED a pm:InvalidGgenFile_Classification ;
  rdfs:label "MIGRATION_REQUIRED" ;
  rdfs:comment "File must be migrated to new location or refactored; blocking but fixable" .

pm:OUT_OF_SCOPE_EXTERNAL_ARTIFACT a pm:InvalidGgenFile_Classification ;
  rdfs:label "OUT_OF_SCOPE_EXTERNAL_ARTIFACT" ;
  rdfs:comment "File is generated artifact in external project; non-blocking" .

pm:BLOCKING_SOURCE_SURFACE a pm:InvalidGgenFile_Classification ;
  rdfs:label "BLOCKING_SOURCE_SURFACE" ;
  rdfs:comment "File is source surface with .ggen extension in Prompt Manufactory scope; blocks ALIVE" .

