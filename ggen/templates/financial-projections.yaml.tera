# Financial Projections — M&A Valuation Model
#
# Generated: {{ now() | date(format="%Y-%m-%dT%H:%M:%SZ") }}
# Authority: Process Intelligence Research Directorate

projections:
{% for proj in results | sort(attribute="scenario_type") %}
  - id: "{{ proj.projection_id }}"
    scenario_type: "{{ proj.scenario_type }}"
    year: {{ proj.year }}
    revenue_impact: {{ proj.revenue_impact }}
    cost_savings: {{ proj.cost_savings }}
    integration_cost: {{ proj.integration_cost }}
    net_present_value: {{ proj.net_present_value }}
    confidence_level: "{{ proj.confidence_level }}"
    assumptions:
      {% for assumption in proj.assumptions | split(pat=",") %}
      - {{ assumption | trim }}
      {% endfor %}
{% endfor %}

metadata:
  generated_timestamp: "{{ now() | date(format="%Y-%m-%dT%H:%M:%SZ") }}"
  authority: "Process Intelligence Research Directorate"
  compliance: "BOARD-ADMISSIBLE"
  version: "1.0"
