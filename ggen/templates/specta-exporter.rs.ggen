// THIS IS A GENERATED Rust code template (.rs.ggen) for Specta Type Export.
// Variables:
// - output_file_path: Absolute or relative path to write the TypeScript bindings.
// - types: A list of fully-qualified Rust types to export (e.g., ["crate::models::User", "crate::models::Action"])
// - use_serde: Boolean, whether to run types through specta_serde processing.

use std::fs::{create_dir_all, File};
use std::io::Write;
use std::path::Path;
use specta::Types;
use specta_typescript::Typescript;

/// Automatically exports Rust type definitions into TypeScript bindings.
/// Handled programmatically via Specta reflection engine.
fn main() -> Result<(), Box<dyn std::error::Error>> {
    let output_path = Path::new("{{ output_file_path }}");

    // Ensure target directory exists before writing
    if let Some(parent) = output_path.parent() {
        create_dir_all(parent)?;
    }

    println!("Initializing Specta type registry...");
    let mut registry = Types::default();

    // Register all targeted types
    {% for type in types -%}
    println!("Registering type: {}", "{{ type }}");
    registry.register::<{{ type }}>();
    {% endfor %}

    // Apply Serde attribute transformations if configured
    {% if use_serde -%}
    println!("Applying Serde transformation layer using specta-serde...");
    let processed_registry = match specta_serde::process_for_serialization(&registry) {
        Ok(processed) => processed,
        Err(err) => {
            eprintln!("CRITICAL ERROR: Failed to apply Serde layout parsing to type registry. Error: {:?}", err);
            std::process::exit(1);
        }
    };
    {% else -%}
    let processed_registry = registry;
    {% endif %}

    println!("Generating TypeScript definitions...");
    let ts_exporter = Typescript::default();
    
    // Generate type definitions as String first to validate content
    let bindings_content = match ts_exporter.export(&processed_registry) {
        Ok(content) => content,
        Err(err) => {
            eprintln!("CRITICAL ERROR: Failed to generate TypeScript definitions. Error: {:?}", err);
            std::process::exit(1);
        }
    };

    // Add standard generation header to prevent manual edits in client application
    let mut file = File::create(output_path)?;
    writeln!(file, "/*")?;
    writeln!(file, " * This file was automatically generated by the specta-exporter pipeline.")?;
    writeln!(file, " * DO NOT EDIT THIS FILE MANUALLY.")?;
    writeln!(file, " * All modifications will be overwritten upon next build/generation run.")?;
    writeln!(file, " */\n")?;
    
    file.write_all(bindings_content.as_bytes())?;
    file.flush()?;

    println!("TypeScript bindings successfully written to: {}", output_path.display());
    Ok(())
}
