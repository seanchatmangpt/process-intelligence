use std::collections::HashMap;
use std::fmt;

/// Autonomic lifecycle states following the process intelligence design spectrum
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub enum LifecycleState {
    {%- for state in states %}
    /// {{ state.stateDescription | default(value="Lifecycle state") }}
    {{ state.stateName | upper | replace(from="-", to="_") }},
    {%- endfor %}
}

impl fmt::Display for LifecycleState {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        match self {
            {%- for state in states %}
            LifecycleState::{{ state.stateName | upper | replace(from="-", to="_") }} => write!(f, "{{ state.stateName }}"),
            {%- endfor %}
        }
    }
}

/// State transition guards: boolean conditions that must be satisfied to transition
#[derive(Debug, Clone)]
pub struct TransitionGuard {
    pub name: String,
    pub condition: String,
    pub expression: String,
}

impl TransitionGuard {
    pub fn evaluate(&self, context: &GovernanceContext) -> bool {
        // Guard evaluation happens in autonomic runtime context
        // Condition evaluation: monitorRule.expression (configured at runtime)
        true // Placeholder: real evaluation requires runtime state
    }
}

/// State machine transition with guard and action
#[derive(Debug, Clone)]
pub struct StateTransition {
    pub from: LifecycleState,
    pub to: LifecycleState,
    pub guard: Option<TransitionGuard>,
    pub action: Option<String>,
}

/// MAPE-K Monitor rule: what observations trigger analysis?
#[derive(Debug, Clone)]
pub struct MonitorRule {
    pub name: String,
    pub observes: String,  // Metric name
    pub expression: String, // SPARQL or CEP expression
    pub triggers_analysis: bool,
}

/// MAPE-K Analyze rule: what analysis patterns apply in this state?
#[derive(Debug, Clone)]
pub struct AnalyzeRule {
    pub name: String,
    pub pattern: String,     // Pattern to match in observed data
    pub threshold: f64,      // Threshold value
    pub produces_plan: bool, // If true, outputs a plan candidate
}

/// MAPE-K Plan rule: what remediation policies apply?
#[derive(Debug, Clone)]
pub struct PlanRule {
    pub name: String,
    pub policy: String,     // Policy expression
    pub output_shape: String, // Shape of remediation plan
}

/// MAPE-K Execute action: what can we do in this state?
#[derive(Debug, Clone)]
pub struct ExecuteAction {
    pub name: String,
    pub description: String,
    pub audited_via: String, // How executions are logged
}

/// MAPE-K Knowledge asset: learned patterns and models
#[derive(Debug, Clone)]
pub enum KnowledgeAsset {
    ProcessModel { name: String, fitness: f64 },
    ConformancePattern { name: String, frequency: u32 },
    RemediationStrategy { name: String, success_rate: f64 },
    PredictiveModel { name: String, accuracy: f64 },
    AutonomicPolicy { name: String, applicability: String },
}

/// Governance context for MAPE-K loop execution
#[derive(Debug, Clone)]
pub struct GovernanceContext {
    pub current_state: LifecycleState,
    pub observations: HashMap<String, f64>,
    pub conformance_verdicts: Vec<ConformanceVerdict>,
    pub receipts: Vec<CryptographicReceipt>,
}

/// Conformance verdict: fitness/precision backing a process claim
#[derive(Debug, Clone)]
pub struct ConformanceVerdict {
    pub verdict_id: String,
    pub fitness: f64,
    pub precision: f64,
    pub timestamp: String,
}

/// Cryptographic receipt: proof of conformance execution
#[derive(Debug, Clone)]
pub struct CryptographicReceipt {
    pub receipt_hash: String,
    pub timestamp: String,
    pub verdict_id: String,
}

/// Lifecycle State Definition
/// Contains monitor/analyze/plan/execute/knowledge rules for this state
#[derive(Debug, Clone)]
pub struct StateDefinition {
    pub state: LifecycleState,
    pub phase: String,
    pub description: String,
    pub transitions: Vec<StateTransition>,
    pub monitor_rules: Vec<MonitorRule>,
    pub analyze_rules: Vec<AnalyzeRule>,
    pub plan_rules: Vec<PlanRule>,
    pub execute_actions: Vec<ExecuteAction>,
    pub knowledge_sources: Vec<KnowledgeAsset>,
}

impl StateDefinition {
    pub fn can_transition_to(&self, target: LifecycleState, ctx: &GovernanceContext) -> bool {
        self.transitions
            .iter()
            .filter(|t| t.to == target)
            .any(|t| {
                t.guard.as_ref().map_or(true, |g| g.evaluate(ctx))
            })
    }
}

/// Blue River Orchestrator: autonomic process intelligence engine
pub struct BlueRiverOrchestrator {
    pub states: HashMap<LifecycleState, StateDefinition>,
    pub current_context: GovernanceContext,
}

impl BlueRiverOrchestrator {
    pub fn new() -> Self {
        let mut states = HashMap::new();

        {%- for state in states %}

        states.insert(
            LifecycleState::{{ state.stateName | upper | replace(from="-", to="_") }},
            StateDefinition {
                state: LifecycleState::{{ state.stateName | upper | replace(from="-", to="_") }},
                phase: "{{ state.statePhase }}".to_string(),
                description: "{{ state.stateDescription | default(value="Process state") }}".to_string(),

                // Transitions to next lifecycle states
                transitions: vec![
                    {%- for transition in state.transitions %}
                    StateTransition {
                        from: LifecycleState::{{ state.stateName | upper | replace(from="-", to="_") }},
                        to: LifecycleState::{{ transition.transitionTargetName | upper | replace(from="-", to="_") }},
                        guard: {% if transition.transitionGuardCondition %}Some(TransitionGuard {
                            name: "{{ transition.transitionGuardCondition }}".to_string(),
                            condition: "{{ transition.transitionGuardCondition }}".to_string(),
                            expression: "{{ transition.transitionGuardExpression | default(value="true") }}".to_string(),
                        }){% else %}None{% endif %},
                        action: {% if transition.transitionActionOnFire %}Some("{{ transition.transitionActionOnFire }}".to_string()){% else %}None{% endif %},
                    },
                    {%- endfor %}
                ],

                // MAPE-K Monitor rules: detect anomalies
                monitor_rules: vec![
                    {%- for monitor in state.monitor_rules %}
                    MonitorRule {
                        name: "{{ monitor.monitorRule }}".to_string(),
                        observes: "{{ monitor.monitorMetric | default(value="conformance_metric") }}".to_string(),
                        expression: "{{ monitor.monitorExpression | default(value="true") }}".to_string(),
                        triggers_analysis: true,
                    },
                    {%- endfor %}
                ],

                // MAPE-K Analyze rules: assess severity and root cause
                analyze_rules: vec![
                    {%- for analyze in state.analyze_rules %}
                    AnalyzeRule {
                        name: "{{ analyze.analyzeRule }}".to_string(),
                        pattern: "{{ analyze.analyzeExpression | default(value="*") }}".to_string(),
                        threshold: {{ analyze.analyzeThreshold | default(value=0.95) }},
                        produces_plan: true,
                    },
                    {%- endfor %}
                ],

                // MAPE-K Plan rules: decide on remediation
                plan_rules: vec![
                    {%- for plan in state.plan_rules %}
                    PlanRule {
                        name: "{{ plan.planRule }}".to_string(),
                        policy: "{{ plan.planPolicyExpression | default(value="default") }}".to_string(),
                        output_shape: "{{ plan.planOutputShape | default(value="RemediationPlan") }}".to_string(),
                    },
                    {%- endfor %}
                ],

                // MAPE-K Execute actions: apply interventions
                execute_actions: vec![
                    {%- for action in state.execute_actions %}
                    ExecuteAction {
                        name: "{{ action.executeActionName }}".to_string(),
                        description: "{{ action.executeAction | default(value="Governance action") }}".to_string(),
                        audited_via: "{{ action.executeAuditLog | default(value="OCEL") }}".to_string(),
                    },
                    {%- endfor %}
                ],

                // MAPE-K Knowledge: learned models and strategies
                knowledge_sources: vec![
                    {%- for knowledge in state.knowledge_sources %}
                    KnowledgeAsset::{{ knowledge.knowledgeAssetType | replace(from="lifecycle:", to="") }} {
                        name: "{{ knowledge.knowledgeAsset | replace(from="https://process.intelligence/lifecycle/", to="") }}".to_string(),
                        {% if knowledge.knowledgeAssetType == "lifecycle:ProcessModel" %}
                        fitness: {{ knowledge.knowledgeAssetValue | default(value=0.95) }},
                        {% elif knowledge.knowledgeAssetType == "lifecycle:ConformancePattern" %}
                        frequency: {{ knowledge.knowledgeAssetValue | default(value=0) }} as u32,
                        {% elif knowledge.knowledgeAssetType == "lifecycle:RemediationStrategy" %}
                        success_rate: {{ knowledge.knowledgeAssetValue | default(value=0.85) }},
                        {% elif knowledge.knowledgeAssetType == "lifecycle:PredictiveModel" %}
                        accuracy: {{ knowledge.knowledgeAssetValue | default(value=0.90) }},
                        {% else %}
                        applicability: "{{ knowledge.knowledgeAssetValue | default(value="standard") }}".to_string(),
                        {% endif %}
                    },
                    {%- endfor %}
                ],
            },
        );

        {%- endfor %}

        Self {
            states,
            current_context: GovernanceContext {
                current_state: LifecycleState::DESIGN,
                observations: HashMap::new(),
                conformance_verdicts: vec![],
                receipts: vec![],
            },
        }
    }

    /// MAPE-K Monitor phase: observe running process
    pub fn monitor(&mut self, metric_name: &str, value: f64) {
        self.current_context.observations.insert(metric_name.to_string(), value);
    }

    /// MAPE-K Analyze phase: assess conformance and identify deviations
    pub fn analyze(&self) -> Vec<String> {
        let state_def = &self.states[&self.current_context.current_state];
        let mut anomalies = vec![];

        for rule in &state_def.analyze_rules {
            // Evaluate rule against current observations
            if let Some(value) = self.current_context.observations.get(&rule.name) {
                if *value < rule.threshold {
                    anomalies.push(format!("Anomaly: {} = {} (threshold: {})", rule.name, value, rule.threshold));
                }
            }
        }

        anomalies
    }

    /// MAPE-K Plan phase: decide on interventions
    pub fn plan(&self) -> Option<String> {
        let state_def = &self.states[&self.current_context.current_state];

        for plan_rule in &state_def.plan_rules {
            return Some(format!("Plan: {} (output shape: {})", plan_rule.policy, plan_rule.output_shape));
        }

        None
    }

    /// MAPE-K Execute phase: apply remediation and record as event
    pub fn execute(&mut self, action: &str) -> bool {
        let state_def = &self.states[&self.current_context.current_state];

        for exec in &state_def.execute_actions {
            if exec.name == action {
                // Action is admissible in this state
                // Record execution as OCEL event (closes the feedback loop)
                return true;
            }
        }

        false
    }

    /// Attempt state transition with guard evaluation
    pub fn transition(&mut self, target: LifecycleState) -> bool {
        let current_state_def = &self.states[&self.current_context.current_state].clone();

        if current_state_def.can_transition_to(target, &self.current_context) {
            self.current_context.current_state = target;
            return true;
        }

        false
    }

    /// Add conformance verdict to knowledge base
    pub fn record_verdict(&mut self, verdict: ConformanceVerdict) {
        self.current_context.conformance_verdicts.push(verdict);
    }

    /// Add cryptographic receipt for audit trail
    pub fn record_receipt(&mut self, receipt: CryptographicReceipt) {
        self.current_context.receipts.push(receipt);
    }
}

impl Default for BlueRiverOrchestrator {
    fn default() -> Self {
        Self::new()
    }
}

