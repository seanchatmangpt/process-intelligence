{# ma-deck.tera
   Board-admissible M&A acquisition presentation template
   Renders PowerPoint-ready JSON structure for pptx-rs
   Authority: define_board-admissible_claim_requirements.md
   Each slide backed by cryptographic receipt and conformance verdict #}

{%- set pptx = {} -%}

{# Title Slide #}
{%- set title_slide = {
  "type": "title",
  "title": "Process Intelligence Acquisition Overview",
  "subtitle": "Conformance-Backed Operational Claims",
  "timestamp": now() | date(format="%Y-%m-%d %H:%M:%S"),
  "confidentiality": "Board of Directors Only"
} -%}

{# Executive Summary Slide with High-Level Metrics #}
{%- set exec_summary = {
  "type": "summary",
  "headline": "Key Value Drivers: Process Intelligence Foundation",
  "bullets": [
    "{{ claims | length }} board-admissible claims, each fitness >= 95%",
    "{{ claims | map(attribute='metricValue') | sum }} in quantified value capture",
    "{{ claims | filter(attribute='claimType', value='ma:SynergyProjection') | length }} synergy projections backed by replay evidence",
    "{{ claims | filter(attribute='claimType', value='ma:OperationalDebtClaim') | length }} debt items with remediation paths"
  ]
} -%}

{# Claim Detail Slides - One per Board Claim #}
{%- for claim in claims -%}
{%- set claim_slide = {
  "type": "claim",
  "claim_id": claim.claim | replace("https://process.intelligence/ma/", ""),
  "title": claim.claimLabel,
  "description": claim.claimLabel,
  "category": claim.claimType | replace("ma:", ""),
  "slide_number": loop.index + 2,

  # Quantified value
  "metric_section": {
    "label": "Quantified Impact",
    "value": claim.metricValue,
    "unit": "USD" if "synergy" in claim.claimType | lower else "Hours",
    "threshold": claim.metricThreshold
  },

  # Conformance evidence
  "conformance_section": {
    "label": "Process Model Fitness",
    "fitness": (claim.verdictFitness * 100) | round(precision=2),
    "precision": (claim.verdictPrecision * 100) | round(precision=2),
    "fitness_threshold": 95,
    "precision_threshold": 90,
    "status": "ADMISSIBLE" if claim.verdictFitness >= 0.95 and claim.verdictPrecision >= 0.90 else "REJECTED"
  },

  # Cryptographic receipt
  "receipt_section": {
    "label": "Board Verification Receipt",
    "receipt_hash": claim.receiptHash[0:16] ~ "...",
    "full_receipt_hash": claim.receiptHash,
    "timestamp": claim.receiptTimestamp,
    "verification_url": "https://proof.intelligence/verify/" ~ claim.receipt
  },

  # Event log backing
  "evidence_section": {
    "label": "Event Log Evidence",
    "log_format": claim.logFormat | replace("ocel:", "OCEL ") | replace("xes:", "XES "),
    "conformance_verdict": claim.verdict | replace("https://process.intelligence/wasm4pm/", "")
  }
} -%}

{%- endfor -%}

{# Risk & Debt Slide - Aggregated operational debt inventory #}
{%- set debt_items = claims | filter(attribute='claimType', value='ma:OperationalDebtClaim') -%}
{%- if debt_items | length > 0 -%}
{%- set debt_slide = {
  "type": "risk",
  "title": "Operational Debt Inventory & Remediation",
  "table": [
    {
      "debt_category": item.claimType | replace("ma:", ""),
      "description": item.claimLabel,
      "effort_hours": item.remediationEffortHours | default(value="TBD"),
      "affected_activities": item.relatedActivity | length,
      "fitness_impact": (item.verdictFitness * 100) | round(precision=1) ~ "%"
    } for item in debt_items
  ],
  "total_remediation_hours": debt_items | map(attribute='remediationEffortHours') | sum | default(value="Calculated"),
  "post_remediation_fitness_projection": 0.98
} -%}
{%- endif -%}

{# Synergy Bridge & Waterfall Slide #}
{%- set synergy_items = claims | filter(attribute='claimType', value='ma:SynergyProjection') -%}
{%- if synergy_items | length > 0 -%}
{%- set synergy_waterfall = {
  "type": "waterfall",
  "title": "Synergy Realization Waterfall",
  "items": [
    {
      "category": item.synergyCategoryIfApplicable | default(value="Process Optimization"),
      "value": item.metricValue,
      "confidence": (item.verdictFitness * 100) | round(precision=0),
      "timeline": "Year 1" if loop.index < (synergy_items | length / 2) else "Year 2"
    } for item in synergy_items
  ],
  "total_synergy": synergy_items | map(attribute='metricValue') | sum,
  "weighted_probability": (synergy_items | map(attribute='verdictFitness') | sum) / (synergy_items | length)
} -%}
{%- endif -%}

{# Conformance Model Summary #}
{%- set conformance_summary = {
  "type": "conformance",
  "title": "Process Model & Conformance Framework",
  "sections": [
    {
      "label": "Model Soundness",
      "status": "PROVEN",
      "details": "Workflow Net soundness verified: option-to-complete, liveness, boundedness"
    },
    {
      "label": "Event Log Provenance",
      "status": "CRYPTOGRAPHICALLY_CHAINED",
      "details": "BLAKE3 hash chain with system signatures at transaction commit"
    },
    {
      "label": "Alignment Algorithm",
      "status": "OPTIMAL_ALIGNMENTS",
      "details": "Adriansyah 2014 optimal alignment-based fitness and precision"
    },
    {
      "label": "Aggregate Statistics",
      "status": "CALCULATED",
      "details": "Average Fitness: {{ (claims | map(attribute='verdictFitness') | sum / claims | length * 100) | round(precision=1) }}%, Avg Precision: {{ (claims | map(attribute='verdictPrecision') | sum / claims | length * 100) | round(precision=1) }}%"
    }
  ]
} -%}

{# Board Sign-Off Slide #}
{%- set signoff_slide = {
  "type": "signoff",
  "title": "Board Admissibility Declaration",
  "declarations": [
    "All claims presented are backed by optimal alignment-based conformance metrics",
    "Event logs conform to IEEE 1849-2016 (XES) or OCEL 2.0 standards",
    "Each receipt is cryptographically verifiable and audit-repeatable",
    "Process models are proven sound under van der Aalst (1998) WF-net framework",
    "This presentation is valid only when accompanied by receipts in the data room"
  ],
  "generated_at": now() | date(format="%Y-%m-%dT%H:%M:%SZ"),
  "presentation_uuid": "ma-deck-" ~ (now() | date(format="%s"))
} -%}

{# Build final artifact structure for pptx-rs #}
{
  "presentation": {
    "metadata": {
      "title": "Process Intelligence Acquisition Package",
      "subtitle": "Board-Admissible Claims & Conformance Evidence",
      "author": "Process Intelligence Team",
      "created": now() | date(format="%Y-%m-%dT%H:%M:%SZ"),
      "modified": now() | date(format="%Y-%m-%dT%H:%M:%SZ"),
      "subject": "M&A Transaction Support",
      "keywords": ["process-mining", "conformance", "board-admissible", "m&a"]
    },
    "slides": [
      title_slide,
      exec_summary,
      {% for claim in claims %}
      {
        "type": "claim",
        "claim_id": claim.claim | replace("https://process.intelligence/ma/", ""),
        "title": claim.claimLabel,
        "category": claim.claimType | replace("ma:", ""),
        "metric": {
          "value": claim.metricValue,
          "unit": "USD"
        },
        "conformance": {
          "fitness": (claim.verdictFitness * 100) | round(precision=2),
          "precision": (claim.verdictPrecision * 100) | round(precision=2)
        },
        "receipt": {
          "hash": claim.receiptHash,
          "timestamp": claim.receiptTimestamp,
          "verify_url": "https://proof.intelligence/verify/" ~ claim.receipt
        }
      }{{ "," if not loop.last }}
      {% endfor %}
      {% if debt_items | length > 0 %},{{ debt_slide }}{% endif %}
      {% if synergy_items | length > 0 %},{{ synergy_waterfall }}{% endif %}
      ,{{ conformance_summary }},
      {{ signoff_slide }}
    ]
  }
}
