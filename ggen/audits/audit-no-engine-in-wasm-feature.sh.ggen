#!/usr/bin/env bash
# audit-no-engine-in-wasm-feature.sh
# Autogenerated audit script for wasm4pm-compat WASM boundary compliance.
# Generated from ggen/audits/audit-no-engine-in-wasm-feature.sh.ggen
# Renders checking routines mapping forbidden execution states from doctrine and ledger rules.

set -euo pipefail

# Configuration
CRATE_DIR="/Users/sac/process-intelligence"
VIOLATIONS=0

echo "=========================================================================="
echo "Running WASM Boundary Law Audit for wasm4pm-compat"
echo "=========================================================================="

# 1. Dependency Tree Audits
echo "[Step 1] Inspecting Cargo Dependency Tree..."
if ! command -v cargo &> /dev/null; then
    echo "WARNING: cargo command not found in current path. Skipping cargo tree inspection."
else
    # Check if execution crates are pulled in by target features
    FORBIDDEN_DEPS=(
        "wasm4pm-engine"
        "conformance-solver"
        "replay-engine"
        "sparql-query"
        "petri-net-execution"
        "inductive-miner"
    )
    
    # Get dependency tree for the wasm feature
    DEP_TREE=$(cargo tree -p wasm4pm-compat --features wasm 2>/dev/null || true)
    
    if [ -n "$DEP_TREE" ]; then
        for dep in "${FORBIDDEN_DEPS[@]}"; do
            if echo "$DEP_TREE" | grep -q "$dep"; then
                echo "ERROR: Forbidden dependency smuggled into wasm feature: $dep"
                VIOLATIONS=$((VIOLATIONS + 1))
            fi
        done
    else
        echo "Crate wasm4pm-compat not found in workspace or targets. Skipping dependency check."
    fi
fi

# 2. Source Code Smuggling Audits
echo "[Step 2] Scanning compatibility source files for execution smuggling..."
FORBIDDEN_PATTERNS=(
    {% for op in forbidden_operations %}
    "{{ op.name }}"
    {% endfor %}
    "AStarSolver"
    "TokenGame"
    "AlphaMiner"
    "HeuristicMiner"
    "InductiveMiner"
    "conformance_verdict"
    "execute_ocpq"
    "simulate_replay"
    "compute_alignment"
    "discover_model"
    "mint_receipt"
)

# Search within src files that might be compiled for wasm
# Specifically targeting cfg(feature = "wasm") or cfg(target_arch = "wasm32") blocks
COMPAT_SRC_DIR="$CRATE_DIR/src"
if [ -d "$COMPAT_SRC_DIR" ]; then
    for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
        # Exclude generated binding declarations, target/pkg directories, and templates
        MATCHES=$(grep -rnw "$COMPAT_SRC_DIR" -e "$pattern" \
          --exclude-dir="target" \
          --exclude-dir="pkg" \
          --exclude="*.ggen" \
          --exclude="*test*" \
          || true)
        
        if [ -n "$MATCHES" ]; then
            echo "ERROR: Forbidden execution logic pattern '$pattern' found in source code:"
            echo "$MATCHES"
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
    done
else
    echo "Crate source directory $COMPAT_SRC_DIR not found. Skipping source scan."
fi

# 3. Final Verdict
if [ "$VIOLATIONS" -gt 0 ]; then
    echo "=========================================================================="
    echo "AUDIT FAILED: $VIOLATIONS boundary compliance violations found!"
    echo "=========================================================================="
    exit 1
else
    echo "=========================================================================="
    echo "AUDIT PASSED: WASM feature is clean of execution logic."
    echo "=========================================================================="
    exit 0
fi
